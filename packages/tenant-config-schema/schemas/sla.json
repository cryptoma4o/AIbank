{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aibank.io/schemas/tenant-config/v1.0.0/sla.json",
  "title": "SLAConfig",
  "description": "Tenant-level SLA targets. Validates configs/tenants/<id>/sla.yaml.",
  "type": "object",
  "required": ["schema_version", "targets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "targets": {
      "type": "object",
      "required": ["ip", "llc", "jsc"],
      "additionalProperties": { "$ref": "#/definitions/sla_target" },
      "properties": {
        "ip": { "$ref": "#/definitions/sla_target" },
        "llc": { "$ref": "#/definitions/sla_target" },
        "jsc": { "$ref": "#/definitions/sla_target" }
      }
    },
    "on_breach": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "definitions": {
    "sla_target": {
      "type": "object",
      "required": ["auto_processing_minutes", "total_minutes"],
      "additionalProperties": false,
      "properties": {
        "auto_processing_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080,
          "description": "Minutes allowed for the fully-automated portion of the workflow"
        },
        "total_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 43200,
          "description": "Total minutes allowed end-to-end (incl. manual review)"
        },
        "automation_rate_target": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Target share (0..1) of applications decided automatically"
        }
      }
    }
  }
}
