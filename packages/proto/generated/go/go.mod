// Module for AIbank generated Go protobuf and gRPC stubs.
//
// This file is committed (not generated) so that downstream Go services can
// import the package even when `buf generate` has not yet been run locally —
// the produced *.pb.go files land alongside this go.mod and the module
// resolves immediately.
//
// Per ADR-0006, this module never re-exports or wraps generated code; it is
// pure-codegen output plus this module declaration.

module github.com/aibank/platform/packages/proto/generated/go

go 1.22
