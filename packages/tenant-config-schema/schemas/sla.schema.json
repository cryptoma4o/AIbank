{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SLAConfig",
  "type": "object",
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "targets": {
      "type": "object",
      "required": ["ip", "llc", "jsc"],
      "properties": {
        "ip": {"$ref": "#/definitions/sla_target"},
        "llc": {"$ref": "#/definitions/sla_target"},
        "jsc": {"$ref": "#/definitions/sla_target"}
      }
    }
  },
  "definitions": {
    "sla_target": {
      "type": "object",
      "required": ["auto_processing_minutes", "total_minutes"],
      "properties": {
        "auto_processing_minutes": {
          "type": "integer",
          "minimum": 1,
          "description": "Minutes allowed for automated processing stage"
        },
        "total_minutes": {
          "type": "integer",
          "minimum": 1,
          "description": "Total minutes allowed for full onboarding flow"
        }
      }
    }
  }
}
