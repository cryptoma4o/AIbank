{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aibank.io/schemas/tenant-config/v1.0.0/workflow.json",
  "title": "WorkflowConfig",
  "description": "Per-legal-form workflow definition (ip.yaml, llc.yaml, jsc.yaml). Declarative ordered list of steps with conditions.",
  "type": "object",
  "required": ["schema_version", "workflow_name", "steps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "workflow_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Snake-case workflow identifier, e.g. 'llc_onboarding'"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    },
    "error_handling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_retry": { "type": "integer", "minimum": 0, "maximum": 10 },
        "default_timeout_minutes": { "type": "integer", "minimum": 1 },
        "on_step_failure": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "sla": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "identity_verification",
            "document_collection",
            "ai_document_intake",
            "external_data_fetch",
            "ai_reconciliation",
            "ai_ubo_tracing",
            "external_screening",
            "risk_scoring",
            "decision_gate",
            "abs_account_opening",
            "client_notification"
          ]
        },
        "required": { "type": "boolean" },
        "parallel": { "type": "boolean" },
        "requires": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timeout_minutes": { "type": "integer", "minimum": 1 },
        "methods": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": true,
            "properties": {
              "type": { "type": "string" },
              "description": { "type": "string" },
              "required": { "type": "boolean" },
              "formats": {
                "type": "array",
                "items": { "type": "string" }
              },
              "max_size_mb": { "type": "integer", "minimum": 1, "maximum": 200 }
            }
          }
        },
        "auto_approve_if": {
          "type": "array",
          "items": { "type": "string" }
        },
        "otherwise": { "type": "string" },
        "channels": {
          "type": "array",
          "items": { "type": "string", "enum": ["email", "sms", "push"] }
        }
      }
    }
  }
}
